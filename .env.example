# Public URL of the site, used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://heapwaresolutions.com

# SMTP account used to deliver contact-form and newsletter emails.
# For Gmail/Google Workspace use smtp.gmail.com, port 465 and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: where inquiries are sent (defaults to harisali@heapware.com)
# and the From address (defaults to SMTP_USER).
CONTACT_TO=
CONTACT_FROM=
